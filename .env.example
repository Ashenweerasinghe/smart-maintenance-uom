# Azure AI Foundry (Azure OpenAI-compatible) settings for the Maintenance Assistant.
# Copy to .env for local dev, or set these as App Service Application Settings in Azure.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21
